# ⚠️ SECURITY WARNING: NEVER commit your actual .env file with real API keys!
# ⚠️ सावधान: Real API keys को कभी भी Git में commit न करें!
# This is a template - Copy this to server/.env and fill in your actual values

# ===========================================
# 🗄️ DATABASE (Required) - Neon.tech या Railway
# ===========================================
# Get from: https://neon.tech (Free PostgreSQL)
# Example: postgresql://username:password@ep-xyz.neon.tech/repurposex?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/repurposex

# ===========================================
# 🔴 REDIS (Required) - Upstash.com
# ===========================================
# Get from: https://upstash.com (Free tier)
# Example: redis://default:password@redis-host.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ===========================================
# 🤖 AI MODELS (Required - At least one)
# ===========================================
# Groq (FAST & FREE Tier) - Get from: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# Gemini (Free Tier available) - Get from: https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OpenAI (Paid) - Get from: https://platform.openai.com
OPENAI_API_KEY=sk-proj-YOUR-KEY-HERE

# ===========================================
# 🔐 JWT AUTHENTICATION (Required)
# ===========================================
# Generate secure random string:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# ===========================================
# 🌐 SERVER CONFIGURATION (Required)
# ===========================================
PORT=5000
NODE_ENV=development
API_PORT=5000

# ===========================================
# 🔗 CORS & URLS (Required)
# ===========================================
# Development में: http://localhost:3000
# Production में: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# For Frontend (.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# 📁 FILE UPLOAD CONFIGURATION
# ===========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,audio/mp3,application/pdf

# ===========================================
# ☁️ CLOUDINARY (Required for File Uploads)
# ===========================================
# Get from: https://cloudinary.com (Free tier available)
# Dashboard → Settings → Account → Cloud name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# For Frontend (Optional - if you want to upload directly from browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ===========================================
# 💳 RAZORPAY (India Payments) - Required
# ===========================================
# Get from: https://razorpay.com → Dashboard → API Keys
# Test mode: rzp_test_ | Live mode: rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# For Frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ===========================================
# 💳 STRIPE (International) - Optional
# ===========================================
# Get from: https://stripe.com → Dashboard → API Keys
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# For Frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# ===========================================
# 📧 EMAIL (Optional but Recommended)
# ===========================================
# Option 1: SMTP (Gmail, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@repurposex.com

# Option 2: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_key

# Option 3: Resend (Modern alternative)
RESEND_API_KEY=re_your_resend_key

# ===========================================
# ☁️ AWS S3 (Optional - For Production File Storage)
# ===========================================
# Get from: AWS Console → IAM → Create User
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=repurposex-uploads

# Alternative: Cloudflare R2 (Cheaper than S3)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=repurposex-uploads

# ===========================================
# 🔍 MONITORING & ANALYTICS (Optional)
# ===========================================
# Sentry (Error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Mixpanel (Product analytics)
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# PostHog (Open source analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# 🎯 FEATURE FLAGS (Optional)
# ===========================================
ENABLE_ANALYTICS=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_SUBSCRIPTION=true
ENABLE_AI_PROCESSING=true
ENABLE_FILE_UPLOAD=true

# ===========================================
# ⚙️ RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# 🔄 JOB QUEUE (BullMQ with Redis)
# ===========================================
QUEUE_NAME=repurpose-jobs
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3

# ===========================================
# 🎨 SITE METADATA (Frontend)
# ===========================================
NEXT_PUBLIC_SITE_NAME=RepurposeX
NEXT_PUBLIC_SITE_DESCRIPTION=AI-Powered Content Repurposing Platform
NEXT_PUBLIC_SITE_URL=https://repurposex.com

# ===========================================
# 🔒 SECURITY (Production)
# ===========================================
# Session secret for cookies
SESSION_SECRET=your-session-secret-here

# CSRF token secret
CSRF_SECRET=your-csrf-secret-here

# Encryption key for sensitive data
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ===========================================
# 📊 LOGGING (Optional)
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
ENABLE_LOG_FILE=false

# ===========================================
# 🧪 TESTING (Test Environment)
# ===========================================
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/repurposex_test
TEST_REDIS_URL=redis://localhost:6379/1

# ===========================================
# 🚀 DEPLOYMENT INFO (Auto-filled by platforms)
# ===========================================
# Railway/Vercel will set these automatically
# RAILWAY_ENVIRONMENT=production
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app

# ===========================================
# 📝 NOTES
# ===========================================
# 1. Copy this file to:
#    - Backend: server/.env
#    - Frontend: client/.env.local
#
# 2. Fill in all REQUIRED fields marked above
#
# 3. For production:
#    - Use strong, unique values for all secrets
#    - Never use these example values
#    - Update FRONTEND_URL and API_URL to your actual domains
#
# 4. Keep .env files in .gitignore (already done ✅)
#
# 5. For help, see: DEPLOYMENT_INSTRUCTIONS_HINDI.md
